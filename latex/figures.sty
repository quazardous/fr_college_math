% =====================================================================
%  figures.sty — bibliothèque de figures récurrentes des fiches 6e à 3e
%
%  Chaque macro est paramétrée pour être réutilisée telle quelle d'une
%  fiche à l'autre : droite graduée, repère, schéma en barres, solides
%  en perspective cavalière, triangle codé, disque.
%  Chargée automatiquement par fiche.cls.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{figures}[2026/08/13 Figures recurrentes fiches maths college]

\RequirePackage{tikz}
\RequirePackage{pgfmath}
\usetikzlibrary{calc,angles,quotes,arrows.meta,decorations.pathreplacing,
                decorations.markings,patterns,positioning,shapes.geometric}

% Styles communs à toutes les figures
\tikzset{
  fig/.style        = {line width=0.7pt, color=encre},
  figtrait/.style   = {line width=0.5pt, color=encredouce},
  figaccent/.style  = {line width=0.9pt, color=accent},
  figfort/.style    = {line width=1.1pt, color=prioritetrois},
  figleg/.style     = {font=\sffamily\fontsize{7}{8.4}\selectfont, text=encredouce},
  figval/.style     = {font=\sffamily\fontsize{7.4}{9}\selectfont, text=encre},
  figpoint/.style   = {circle, fill=prioritetrois, inner sep=0pt, minimum size=1.6mm},
  figcote/.style    = {figleg, text=accent},
}

% Quadrillage au pas de l'unité de la figure.
%
% Le « step » de TikZ vaut 1 cm par défaut, indépendamment de x= et y= : un
% repère posé en x=8mm voyait donc ses traits dériver des graduations, d'un
% millimètre à chaque case. Le style lit l'unité réelle dans \pgf@xx, si bien
% qu'un quadrillage reste aligné quelle que soit l'échelle choisie.
\tikzset{quadrillage/.style={figtrait, very thin, step={\the\pgf@xx}}}

% ---------------------------------------------------------------------
% \droitegraduee[largeur]{min}{max}{pas}{repères}{tikz en plus}
%   repères : liste « valeur/étiquette », séparée par des virgules.
%   Le dernier argument est injecté tel quel dans le tikzpicture ; il est
%   obligatoire, et vaut {} quand on n'ajoute rien.
%   Ex. \droitegraduee[110mm]{0}{5}{1}{2.5/$\frac{5}{2}$, 4/$4$}{}
% ---------------------------------------------------------------------
% La largeur est posée comme VECTEUR UNITÉ de l'axe des x : les coordonnées
% sont alors les valeurs de la droite elle-même, et la figure mesure exactement
% la largeur demandée. La version précédente calculait une échelle qu'elle
% appliquait à des coordonnées sans unité — donc interprétées en centimètres :
% \droitegraduee[110]{0}{3}{1} produisait une droite de 110 cm de large, dont
% seule l'amorce tenait sur la page.
\newcommand{\droitegraduee}[6][120mm]{%
  \pgfmathsetlengthmacro{\unitedroite}{(#1)/(#3-#2)}%
  \begin{tikzpicture}[x=\unitedroite]
    % axe, prolongé de 6 mm au-delà de la dernière graduation pour la pointe
    \draw[figaccent,-{Stealth[length=2mm]}] (#2,0) -- (#3,0) -- ++(6mm,0);
    % graduations principales
    \foreach \v in {#2,\the\numexpr#2+#4\relax,...,#3}{
      \draw[figaccent] (\v,1.4mm) -- (\v,-1.4mm);
      \node[figval,below=0.6mm] at (\v,-1.4mm) {\v};}
    % repères mis en avant
    \foreach \v/\lab in {#5}{
      \fill[prioritetrois] (\v,0) circle (0.9mm);
      \node[figleg,text=prioritetrois,above=1.2mm,font=\sffamily\bfseries\fontsize{7.4}{9}\selectfont]
        at (\v,0) {\lab};}
    #6
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \droitegradueerelatifs[largeur]{min}{max}{repères}
%   Droite graduée centrée sur zéro, pour les nombres relatifs.
% ---------------------------------------------------------------------
\newcommand{\droitegradueerelatifs}[4][130]{%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \pgfmathsetmacro{\ech}{#1/(#3-#2)}
    \pgfmathsetmacro{\xfin}{(#3-#2)*\ech}
    \pgfmathsetmacro{\xz}{(0-#2)*\ech}
    \draw[figaccent,{Stealth[length=2mm]}-{Stealth[length=2mm]}] (-5,0) -- ({\xfin+5},0);
    \foreach \v in {#2,...,#3}{
      \pgfmathsetmacro{\xv}{(\v-#2)*\ech}
      \draw[figaccent] (\xv,1.4) -- (\xv,-1.4);
      \node[figval,below=0.6mm] at (\xv,-1.4) {\v};}
    \draw[figfort] (\xz,2.6) -- (\xz,-2.6);
    \node[text=prioritetrois,above=2.6mm,font=\sffamily\bfseries\fontsize{7.4}{9}\selectfont]
      at (\xz,0) {0};
    \node[figleg] at ({\xz/2},8) {nombres négatifs};
    \node[figleg] at ({\xz+(\xfin-\xz)/2},8) {nombres positifs};
    \foreach \v/\lab in {#4}{
      \pgfmathsetmacro{\xv}{(\v-#2)*\ech}
      \fill[prioritetrois] (\xv,0) circle (0.9mm);
      \node[text=prioritetrois,above=1.4mm,
            font=\sffamily\bfseries\fontsize{7.4}{9}\selectfont] at (\xv,0) {\lab};}
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \schemabarres{légende1/part1, légende2/part2, ...}{total}
%   Modèle pré-algébrique en barres, explicitement au programme de 6e.
% ---------------------------------------------------------------------
\newcommand{\schemabarres}[3][110]{%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \pgfmathsetmacro{\lg}{#1}
    \pgfmathsetmacro{\tot}{#3}
    \pgfmathsetmacro{\xcur}{0}
    \foreach \lab/\p in {#2}{
      \pgfmathsetmacro{\w}{\p/\tot*\lg}
      \pgfmathsetmacro{\xb}{\xcur+\w}
      \filldraw[fill=accentclair,draw=accent,line width=0.6pt]
        (\xcur,0) rectangle (\xb,7);
      \node[figval] at ({(\xcur+\xb)/2},3.5) {\lab};
      \global\let\xcur\xb}
    \draw[decorate,decoration={brace,amplitude=1.6mm,mirror},figtrait] (0,-1.4) -- ({\lg},-1.4);
    \node[figleg,below=2mm] at ({\lg/2},-1.4) {total : #3};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \repereplan{xmax}{ymax}{points}   points : « x/y/étiquette »
% ---------------------------------------------------------------------
\newcommand{\repereplan}[4][8mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \draw[quadrillage] (0,0) grid (#2,#3);
    \draw[figaccent,-{Stealth[length=2mm]}] (0,0) -- ({#2+0.5},0) node[figleg,right] {$x$};
    \draw[figaccent,-{Stealth[length=2mm]}] (0,0) -- (0,{#3+0.5}) node[figleg,above] {$y$};
    \foreach \i in {1,...,#2} \node[figval,below=0.4mm] at (\i,0) {\i};
    \foreach \j in {1,...,#3} \node[figval,left=0.4mm]  at (0,\j) {\j};
    \node[figval,below left=0.4mm] at (0,0) {0};
    \foreach \a/\b/\lab in {#4}{
      \fill[prioritetrois] (\a,\b) circle (0.9mm);
      \node[figleg,text=prioritetrois,above right=0.2mm,
            font=\sffamily\bfseries\fontsize{7.4}{9}\selectfont] at (\a,\b) {\lab};}
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \pavedroit{longueur}{profondeur}{hauteur}{unité}
%   Perspective cavalière : arêtes cachées en pointillés.
% ---------------------------------------------------------------------
\newcommand{\pavedroit}[5][7mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \pgfmathsetmacro{\L}{#2} \pgfmathsetmacro{\P}{#3} \pgfmathsetmacro{\H}{#4}
    \pgfmathsetmacro{\dx}{\P*0.45} \pgfmathsetmacro{\dy}{\P*0.30}
    \coordinate (A) at (0,0);          \coordinate (B) at (\L,0);
    \coordinate (C) at (\L,\H);        \coordinate (D) at (0,\H);
    \coordinate (A') at (\dx,\dy);     \coordinate (B') at (\L+\dx,\dy);
    \coordinate (C') at (\L+\dx,\H+\dy); \coordinate (D') at (\dx,\H+\dy);
    \fill[accentclair,opacity=0.55] (A)--(B)--(C)--(D)--cycle;
    \draw[fig,dashed,figtrait] (A')--(B') (A')--(D') (A')--(A);
    \draw[fig] (A)--(B)--(C)--(D)--cycle;
    \draw[fig] (B)--(B')--(C')--(C);
    \draw[fig] (D)--(D')--(C');
    % Une cote par direction, et chacune de son côté : à droite, la hauteur
    % et la profondeur se recouvraient jusqu'à se lire comme une seule.
    \node[figcote,below] at (\L/2,0) {#2 #5};
    \node[figcote,left]  at (0,\H/2) {#4 #5};
    \node[figcote,right] at (\L+\dx,\dy/2) {#3 #5};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \cylindrerev{rayon}{hauteur}{unité}
% ---------------------------------------------------------------------
\newcommand{\cylindrerev}[4][7mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \pgfmathsetmacro{\R}{#2} \pgfmathsetmacro{\H}{#3}
    \pgfmathsetmacro{\ry}{\R*0.34}
    \fill[accentclair,opacity=0.55] (-\R,0) rectangle (\R,\H);
    \draw[fig] (-\R,0) -- (-\R,\H);
    \draw[fig] (\R,0) -- (\R,\H);
    \draw[fig] (0,\H) ellipse ({\R} and {\ry});
    \draw[fig] (-\R,0) arc (180:360:{\R} and {\ry});
    \draw[fig,dashed,figtrait] (-\R,0) arc (180:0:{\R} and {\ry});
    \draw[figfort,{Stealth[length=1.6mm]}-] (0,\H) -- (\R,\H)
      node[figcote,midway,above,text=prioritetrois] {$R=#2$ #4};
    \fill[prioritetrois] (0,\H) circle (0.7mm);
    \draw[figaccent,{Stealth[length=1.6mm]}-{Stealth[length=1.6mm]}]
      (\R+0.55,0) -- (\R+0.55,\H) node[figcote,midway,right] {$h=#3$ #4};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \prismedroit{base}{hauteur}{unité}  — prisme droit à base triangulaire
% ---------------------------------------------------------------------
\newcommand{\prismedroit}[4][7mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \pgfmathsetmacro{\B}{#2} \pgfmathsetmacro{\H}{#3}
    \pgfmathsetmacro{\dx}{\H*0.42} \pgfmathsetmacro{\dy}{\H*0.28}
    \coordinate (A) at (0,0); \coordinate (B) at (\B,0); \coordinate (C) at (\B*0.36,\B*0.78);
    \coordinate (A') at (\dx,\dy); \coordinate (B') at (\B+\dx,\dy);
    \coordinate (C') at (\B*0.36+\dx,\B*0.78+\dy);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig,dashed,figtrait] (A')--(B') (A')--(C') (A)--(A');
    \draw[fig] (A)--(B)--(C)--cycle;
    \draw[fig] (B)--(B')--(C')--(C);
    \node[figcote,below] at (\B/2,0) {base};
    % Posée en travers du solide, la légende passait sur les arêtes.
    \node[figcote,right] at (\B+\dx,\dy/2) {hauteur};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \disqueraye{rayon}{unité}  — disque avec rayon et diamètre codés
% ---------------------------------------------------------------------
\newcommand{\disqueraye}[3][9mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \pgfmathsetmacro{\R}{#2}
    \fill[accentclair,opacity=0.7] (0,0) circle (\R);
    \draw[fig] (0,0) circle (\R);
    \draw[figaccent] (-\R,0) -- (\R,0);
    \draw[figfort] (0,0) -- (\R,0) node[figcote,midway,above,text=prioritetrois] {$R$};
    \fill[encre] (0,0) circle (0.7mm);
    \node[figleg,above left=0.2mm] at (0,0) {$O$};
    \node[figcote] at (0,-0.42) {$D=2R$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \triangleangles{angleA}{angleB}{étiquetteC}
%   Triangle quelconque avec deux angles connus et le troisième cherché.
% ---------------------------------------------------------------------
\newcommand{\triangleangles}[4][30mm]{%
  \begin{tikzpicture}
    \pgfmathsetmacro{\aa}{#2} \pgfmathsetmacro{\bb}{#3}
    \coordinate (A) at (0,0);
    \coordinate (B) at (#1,0);
    \coordinate (C) at (intersection cs:
      first line={(A)--($(A)+(\aa:2*#1)$)},
      second line={(B)--($(B)+(180-\bb:2*#1)$)});
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \pic[draw=accent,angle radius=6mm,
         "{\footnotesize$#2^\circ$}",angle eccentricity=1.5] {angle=B--A--C};
    \pic[draw=accent,angle radius=6mm,
         "{\footnotesize$#3^\circ$}",angle eccentricity=1.5] {angle=C--B--A};
    \pic[draw=prioritetrois,line width=0.8pt,angle radius=5mm,
         "{\footnotesize\color{prioritetrois}#4}",angle eccentricity=1.7] {angle=A--C--B};
    \node[figleg,below left] at (A) {$A$};
    \node[figleg,below right] at (B) {$B$};
    \node[figleg,above] at (C) {$C$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \droitesparalleles{angle}  — deux parallèles coupées par une sécante,
%   pour les angles alternes-internes et correspondants (5e).
% ---------------------------------------------------------------------
\newcommand{\droitesparalleles}[2][54mm]{%
  \begin{tikzpicture}
    \coordinate (G1) at (0,15mm);   \coordinate (D1) at (#1,15mm);
    \coordinate (G2) at (0,0);      \coordinate (D2) at (#1,0);
    \coordinate (S1) at (10mm,-8mm);\coordinate (S2) at (#1-10mm,23mm);
    \draw[figaccent] (G1) -- (D1) node[figleg,right] {$(d_1)$};
    \draw[figaccent] (G2) -- (D2) node[figleg,right] {$(d_2)$};
    \draw[fig] (S1) -- (S2) node[figleg,above right] {sécante};
    \coordinate (P) at (intersection of S1--S2 and G1--D1);
    \coordinate (Q) at (intersection of S1--S2 and G2--D2);
    \fill[prioritetrois] (P) circle (0.8mm);
    \fill[prioritetrois] (Q) circle (0.8mm);
    \node[figleg,text=prioritetrois,above left=0.2mm]  at (P) {$#2$};
    \node[figleg,text=prioritetrois,below right=0.2mm] at (Q) {$#2$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \tableaupropo{grandeur1}{grandeur2}{v1a/v2a, v1b/v2b, ...}{coefficient}
%   Tableau de proportionnalité avec la flèche du coefficient.
%   Une cellule vide se note « ? ».
% ---------------------------------------------------------------------
\newcommand{\tableaupropo}[4]{%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \pgfmathsetmacro{\ch}{9}      % hauteur de ligne
    \pgfmathsetmacro{\cl}{20}     % largeur de colonne
    \pgfmathsetmacro{\ce}{34}     % largeur de la colonne des intitulés
    % intitulés
    \node[figval,anchor=west] at (1,{\ch*1.5}) {#1};
    \node[figval,anchor=west] at (1,{\ch*0.5}) {#2};
    \draw[figaccent] (0,0) rectangle ({\ce},{\ch*2});
    \draw[figaccent] (0,{\ch}) -- ({\ce},{\ch});
    % valeurs
    \foreach \a/\b [count=\i from 0] in {#3}{
      \pgfmathsetmacro{\xa}{\ce+\i*\cl}
      \draw[figaccent] ({\xa},0) rectangle ({\xa+\cl},{\ch*2});
      \draw[figaccent] ({\xa},{\ch}) -- ({\xa+\cl},{\ch});
      \node[figval] at ({\xa+\cl/2},{\ch*1.5}) {\a};
      \node[figval] at ({\xa+\cl/2},{\ch*0.5}) {\b};}
    % flèche du coefficient
    \draw[figfort,-{Stealth[length=2mm]}]
      ({\ce+\cl*0.5+2},{\ch*1.5-3}) to[bend left=45] ({\ce+\cl*0.5+2},{\ch*0.5+3});
    \node[text=prioritetrois,anchor=west,
          font=\sffamily\bfseries\fontsize{7.4}{9}\selectfont]
      at ({\ce+\cl*0.5+6},{\ch}) {#4};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \tableaunumeration — les rangs d'un nombre décimal, sur l'exemple 4,107
% ---------------------------------------------------------------------
\newcommand{\tableaunumeration}{%
  \begin{tikzpicture}[x=13mm,y=7mm]
    \foreach \i/\n in {0/centaines,1/dizaines,2/unités}{
      \draw[figtrait] (\i,0) rectangle (\i+1,1);
      \node[figleg] at (\i+0.5,1.32) {\n};}
    \foreach \i/\n in {3/dixièmes,4/centièmes,5/millièmes}{
      \draw[figtrait] (\i+0.16,0) rectangle (\i+1.16,1);
      \node[figleg] at (\i+0.66,1.32) {\n};}
    \node at (2.5,0.5) {\large 4};
    \node[text=prioritetrois,font=\bfseries] at (3.08,0.12) {\large ,};
    \node at (3.66,0.5) {\large 1};
    \node at (4.66,0.5) {\large 0};
    \node at (5.66,0.5) {\large 7};
    \node[figcote] at (1.3,-0.55) {partie entière};
    \node[figcote] at (4.7,-0.55) {partie décimale};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \tableaucarres — les carrés des entiers de 0 à 12
% ---------------------------------------------------------------------
\newcommand{\tableaucarres}{%
  \footnotesize
  \begin{tabular}{@{}>{\bfseries}l|*{13}{>{\centering\arraybackslash}p{6.6mm}}@{}}
    \rowcolor{accent}
    \entetecell{$n$} & \entetecell{0} & \entetecell{1} & \entetecell{2}
    & \entetecell{3} & \entetecell{4} & \entetecell{5} & \entetecell{6}
    & \entetecell{7} & \entetecell{8} & \entetecell{9} & \entetecell{10}
    & \entetecell{11} & \entetecell{12}\\
    $n^{2}$ & 0 & 1 & 4 & 9 & 16 & 25 & 36 & 49 & 64 & 81 & 100 & 121 & 144\\
  \end{tabular}}

% ---------------------------------------------------------------------
% \trianglepythagore{côté1}{côté2}{nomA}{nomB}{nomC}
%   Triangle rectangle en A, avec le codage de l'angle droit et les
%   trois sommets nommés. Les longueurs sont des unités de dessin.
% ---------------------------------------------------------------------
\newcommand{\trianglepythagore}[6][10mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \coordinate (A) at (0,0);
    \coordinate (B) at (#2,0);
    \coordinate (C) at (0,#3);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \draw[figaccent,line width=0.8pt] (0.28,0) -- (0.28,0.28) -- (0,0.28);
    \node[figleg,below left]  at (A) {$#4$};
    \node[figleg,below right] at (B) {$#5$};
    \node[figleg,above left]  at (C) {$#6$};
    \node[figcote,below]      at ({#2/2},0) {$#4#5$};
    \node[figcote,left]       at (0,{#3/2}) {$#4#6$};
    \node[figcote,above right,text=prioritetrois]
      at ({#2/2},{#3/2}) {$#5#6$ \footnotesize(hypoténuse)};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \figuretranslation — un triangle et son image par une translation
% ---------------------------------------------------------------------
\newcommand{\figuretranslation}{%
  \begin{tikzpicture}[x=9mm,y=9mm]
    % La translation est horizontale, et aucun côté du triangle n'approche
    % cette direction : sans quoi les flèches se confondraient avec un côté.
    \coordinate (A) at (0,0); \coordinate (B) at (1.5,0.9); \coordinate (C) at (0.2,1.7);
    \coordinate (v) at (4.4,0);
    \coordinate (A') at ($(A)+(v)$);
    \coordinate (B') at ($(B)+(v)$);
    \coordinate (C') at ($(C)+(v)$);
    \fill[accentclair,opacity=0.75] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \fill[prioritetroisfond] (A')--(B')--(C')--cycle;
    \draw[figfort] (A')--(B')--(C')--cycle;
    \foreach \P/\Q in {A/A',B/B',C/C'}{
      \draw[figtrait,dashed,-{Stealth[length=1.9mm]}] (\P) -- (\Q);}
    \node[figleg,below left]  at (A)  {$A$};
    \node[figleg,below right] at (B)  {$B$};
    \node[figleg,above left]  at (C)  {$C$};
    \node[figleg,below left]  at (A') {$A'$};
    \node[figleg,below right] at (B') {$B'$};
    \node[figleg,above left]  at (C') {$C'$};
    \node[figcote,text=prioritetrois,above] at ($(C)!0.5!(C')+(0,0.5)$)
      {même direction, même sens, même longueur};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \droitedesmilieux — triangle avec le segment des milieux
% ---------------------------------------------------------------------
\newcommand{\droitedesmilieux}{%
  \begin{tikzpicture}[x=11mm,y=11mm]
    \coordinate (A) at (0,0); \coordinate (B) at (3.4,0); \coordinate (C) at (1,2.1);
    \coordinate (I) at ($(A)!0.5!(C)$);
    \coordinate (J) at ($(B)!0.5!(C)$);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \draw[figfort] (I)--(J);
    \fill[prioritetrois] (I) circle (0.8mm) (J) circle (0.8mm);
    \node[figleg,below left]  at (A) {$A$};
    \node[figleg,below right] at (B) {$B$};
    \node[figleg,above]       at (C) {$C$};
    \node[figleg,left]        at (I) {$I$};
    \node[figleg,right]       at (J) {$J$};
    \node[figcote,text=prioritetrois,below] at (1.7,-0.15)
      {$IJ = \frac{AB}{2}$ et $(IJ)\parallel(AB)$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \configthales — configuration « triangle » du théorème de Thalès :
%   M sur [AB], N sur [AC], et (MN) parallèle à (BC).
% ---------------------------------------------------------------------
\newcommand{\configthales}[1][10mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \coordinate (A) at (0,3.4); \coordinate (B) at (-2,0); \coordinate (C) at (3.2,0);
    \coordinate (M) at ($(A)!0.42!(B)$);
    \coordinate (N) at ($(A)!0.42!(C)$);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \draw[figfort] (M)--(N);
    \fill[prioritetrois] (M) circle (0.8mm) (N) circle (0.8mm);
    \node[figleg,above]       at (A) {$A$};
    \node[figleg,below left]  at (B) {$B$};
    \node[figleg,below right] at (C) {$C$};
    \node[figleg,left=0.8mm]  at (M) {$M$};
    \node[figleg,right=0.8mm] at (N) {$N$};
    \node[figcote,text=prioritetrois] at (0.6,-0.65) {$(MN)\parallel(BC)$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \configpapillon — configuration « papillon » : A entre les deux
%   triangles, (MN) parallèle à (BC). Même théorème, autre dessin.
% ---------------------------------------------------------------------
\newcommand{\configpapillon}[1][10mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    % M et N sont les symétriques réduits de B et C : le rapport commun
    % (ici 2/3) garantit le parallélisme sans le poser à la main.
    \coordinate (A) at (0,0); \coordinate (B) at (-1.7,1.5); \coordinate (C) at (-2.2,-0.6);
    \coordinate (M) at (1.133,-1); \coordinate (N) at (1.467,0.4);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \fill[prioritetroisfond] (A)--(M)--(N)--cycle;
    \draw[fig] (B)--(A)--(M) (C)--(A)--(N) (B)--(C);
    \draw[figfort] (M)--(N);
    \fill[encre] (A) circle (0.8mm);
    \node[figleg,above=0.9mm]  at (A) {$A$};
    \node[figleg,above left]   at (B) {$B$};
    \node[figleg,below left]   at (C) {$C$};
    \node[figleg,below right]  at (M) {$M$};
    \node[figleg,above right]  at (N) {$N$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \triangletrigo — triangle rectangle vu depuis un angle aigu, avec les
%   trois côtés nommés par leur rôle : c'est ce vocabulaire, et non les
%   lettres, qui décide entre cosinus, sinus et tangente.
% ---------------------------------------------------------------------
\newcommand{\triangletrigo}[1][8mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \coordinate (A) at (0,0); \coordinate (B) at (4.2,0); \coordinate (C) at (4.2,2.9);
    \fill[accentclair,opacity=0.6] (A)--(B)--(C)--cycle;
    \draw[fig] (A)--(B)--(C)--cycle;
    \draw[figaccent,line width=0.8pt] (4.2,0.34) -- (3.86,0.34) -- (3.86,0);
    \pic[draw=prioritetrois,line width=0.8pt,angle radius=9mm,
         "{\footnotesize\color{prioritetrois}$\alpha$}",angle eccentricity=1.5]
         {angle=B--A--C};
    \node[figleg,below left]  at (A) {$A$};
    \node[figleg,below right] at (B) {$B$};
    \node[figleg,above right] at (C) {$C$};
    \node[figcote,below]      at (2.1,0)   {côté adjacent à $\alpha$};
    \node[figcote,right]      at (4.2,1.45){côté opposé à $\alpha$};
    \node[figcote,rotate=34.6,above=0.2mm] at (2.0,1.38) {hypoténuse};
  \end{tikzpicture}}

% ---------------------------------------------------------------------
% \carreidentite — le carré de côté a+b découpé en quatre morceaux.
%   La preuve visuelle de $(a+b)^2 = a^2+2ab+b^2$ : le double produit est
%   la paire de rectangles qu'on oublie.
% ---------------------------------------------------------------------
\newcommand{\carreidentite}[1][9mm]{%
  \begin{tikzpicture}[x=#1,y=#1]
    \pgfmathsetmacro{\ca}{2.5} \pgfmathsetmacro{\cb}{1.4}
    \fill[accentclair]            (0,0)   rectangle (\ca,\ca);
    \fill[prioritetroisfond]      (\ca,\ca) rectangle ({\ca+\cb},{\ca+\cb});
    \fill[accentmoyen,opacity=0.5](\ca,0) rectangle ({\ca+\cb},\ca);
    \fill[accentmoyen,opacity=0.5](0,\ca) rectangle (\ca,{\ca+\cb});
    \draw[fig] (0,0) rectangle ({\ca+\cb},{\ca+\cb});
    \draw[fig] (\ca,0) -- (\ca,{\ca+\cb})  (0,\ca) -- ({\ca+\cb},\ca);
    \node[figval] at ({\ca/2},{\ca/2})           {$a^{2}$};
    \node[figval] at ({\ca+\cb/2},{\ca+\cb/2})   {$b^{2}$};
    \node[figval] at ({\ca+\cb/2},{\ca/2})       {$ab$};
    \node[figval] at ({\ca/2},{\ca+\cb/2})       {$ab$};
    \draw[figaccent,{Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}]
      (0,-0.5) -- (\ca,-0.5) node[figcote,midway,below] {$a$};
    \draw[figaccent,{Stealth[length=1.8mm]}-{Stealth[length=1.8mm]}]
      (\ca,-0.5) -- ({\ca+\cb},-0.5) node[figcote,midway,below] {$b$};
  \end{tikzpicture}}

